{
    "name": "Midnight Purple Deep",
    "type": "dark",
    "colors": {
        // Navbar superior
        "titleBar.activeBackground": "#1F2547",
        "titleBar.activeForeground": "#C7d2FE",
        "titleBar.inactiveBackground": "#141523",
        "titleBar.inactiveForeground": "#8b9CF7",

        "breadcrumb.foreground": "#7A83B6",
        "focusBorder": "#5D5A8D",

        // Tabs
        "editorGroupHeader.tabsBackground": "#2B3461",
        "tab.activeBackground": "#3A3F7A",
        "tab.activeForeground": "#FFFFFF",      
        "tab.inactiveBackground": "#141523",
        "tab.inactiveForeground": "#A5b4FC",

        // Navbar Superior - Menu seleção
        "list.activeSelectionBackground": "#3A3F7A",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.hoverBackground": "#2B3461",

        // Edição
        "editor.background": "#141523",
        "editor.foreground": "#E6E7F2",
        
        // Navbar Lateral 
        "activityBar.background": "#141524",
        "activityBar.foreground": "#A5B4FC",
        "activityBar.activeBorder": "#6366f1",

        // Contador de notificações
        "activityBarBadge.background": "#5E51AF",
        "activityBarBadge.foreground": "#FFFFFF",
        
        // Barra de baixo 
        "statusBar.background": "#574CA3",
        "statusBar.foreground": "#FFFFFF",
        "statusBar.border": "#2E1065",

        // Titulo da janela lateral selecionada
        "sideBarTitle.foreground": "#B0ADFB",

        // Fundo do Painel da janela lateral selecionada
        "sideBar.background": "#111120",
        "sideBar.border": "#5E51AF",
        "sideBar.foreground": "#E6E7F2",

        // Botão Commit
        "button.background": "#7C82F3",
        "button.foreground": "#FFFFFF",
        "button.hoverBackground": "#8B9CF7",

        // Terminal
        "terminal.background": "#1F2033",
        "terminal.foreground": "#E6E7F2",
        "terminalCursor.foreground": "#8F6DFF",
        "terminal.selectionBackground": "#7F47D980",

        "terminal.ansiBlack": "#141523",
        "terminal.ansiRed": "#E05A6F",
        "terminal.ansiGreen": "#20BB94",
        "terminal.ansiYellow": "#E6D66F",
        "terminal.ansiBlue": "#5F8DF0",
        "terminal.ansiMagenta": "#CA5DAD",
        "terminal.ansiCyan": "#8EE6CF",
        "terminal.ansiWhite": "#E6E7F2",

        "terminal.ansiBrightBlack": "#6B6E8F",
        "terminal.ansiBrightRed": "#F07178",
        "terminal.ansiBrightGreen": "#4CD9B0",
        "terminal.ansiBrightYellow": "#F0E68C",
        "terminal.ansiBrightBlue": "#8FA8FF",
        "terminal.ansiBrightMagenta": "#E6A3D0",
        "terminal.ansiBrightCyan": "#9FE8D5",
        "terminal.ansiBrightWhite": "#FFFFFF",

        //Menu
        "menu.background": "#282834",
        "menu.foreground": "#E6E7F2",
        "menu.separatorBackground": "#272A49",

        "progressBar.background": "#7C82F3",

        // Pagina de boas vindas
        "welcomePage.tileBackground": "#2B305E",
        "welcomePage.tileHoverBackground": "#343B6E",
        "textLink.foreground": "#A5B4FC",
        "textLink.activeForeground": "#C7D2FE",
        "badge.background": "#7C82F3",
        "badge.foreground": "#FFFFFF",

        // Seleção de texto
        "editor.lineHighlightBackground": "#262A52",
        "editor.lineHighlightBorder": "#4B4FA3",

        "editor.selectionBackground": "#4B4FA366",
        "editor.selectionHighlightBackground": "#7F47D933",
        "editorCursor.foreground": "#A5B4FC",

        // Números de linhas
        "editorLineNumber.foreground": "#5C64A8",
        "editorLineNumber.activeForeground": "#E6E7F2",

        // Guias de indentação
        "editorIndentGuide.background1": "#2A2F5A88",
        "editorIndentGuide.activeBackground1": "#7C82F3",

        //scroll
        "scrollbarSlider.background": "#343B6E66",
        "scrollbarSlider.hoverBackground": "#7C82F388",
        "scrollbarSlider.activeBackground": "#A5B4FCAA",
    },
    
     "tokenColors": [
        {
            "scope": [
                "emphasis"
            ],
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "strong"
            ],
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "header"
            ],
            "settings": {
                "foreground": "#B07AE6"
            }
        },
        {
            "scope": [
                "meta.diff",
                "meta.diff.header"
            ],
            "settings": {
                "foreground": "#6B6E8F"
            }
        },
        {
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#20BB94"
            }
        },
        {
            "scope": [
                "markup.deleted"
            ],
            "settings": {
                "foreground": "#E05A6F"
            }
        },
        {
            "scope": [
                "markup.changed"
            ],
            "settings": {
                "foreground": "#E8A763"
            }
        },
        {
            "scope": [
                "invalid"
            ],
            "settings": {
                "foreground": "#E05A6F",
                "fontStyle": "underline italic"
            }
        },
        {
            "scope": [
                "invalid.deprecated"
            ],
            "settings": {
                "foreground": "#E6E7F2",
                "fontStyle": "underline italic"
            }
        },
        {
            "scope": [
                "entity.name.filename"
            ],
            "settings": {
                "foreground": "#ECE29C"
            }
        },
        {
            "scope": [
                "markup.error"
            ],
            "settings": {
                "foreground": "#E05A6F"
            }
        },
        {
            "name": "Underlined markup",
            "scope": [
                "markup.underline"
            ],
            "settings": {
                "fontStyle": "underline"
            }
        },
        {
            "name": "Bold markup",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#E8A763"
            }
        },
        {
            "name": "Markup headings",
            "scope": [
                "markup.heading"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#B07AE6"
            }
        },
        {
            "name": "Markup italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#ECE29C",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Bullets, lists (prose)",
            "scope": [
                "beginning.punctuation.definition.list.markdown",
                "beginning.punctuation.definition.quote.markdown",
                "punctuation.definition.link.restructuredtext"
            ],
            "settings": {
                "foreground": "#5F8DF0"
            }
        },
        {
            "name": "Inline code (prose)",
            "scope": [
                "markup.inline.raw",
                "markup.raw.restructuredtext"
            ],
            "settings": {
                "foreground": "#20BB94"
            }
        },
        {
            "name": "Links (prose)",
            "scope": [
                "markup.underline.link",
                "markup.underline.link.image"
            ],
            "settings": {
                "foreground": "#5F8DF0"
            }
        },
        {
            "name": "Link text, image alt text (prose)",
            "scope": [
                "meta.link.reference.def.restructuredtext",
                "punctuation.definition.directive.restructuredtext",
                "string.other.link.description",
                "string.other.link.title"
            ],
            "settings": {
                "foreground": "#CA5DAD"
            }
        },
        {
            "name": "Blockquotes (prose)",
            "scope": [
                "entity.name.directive.restructuredtext",
                "markup.quote"
            ],
            "settings": {
                "foreground": "#ECE29C",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Horizontal rule (prose)",
            "scope": [
                "meta.separator.markdown"
            ],
            "settings": {
                "foreground": "#6B6E8F"
            }
        },
        {
            "name": "Code blocks",
            "scope": [
                "fenced_code.block.language",
                "markup.raw.inner.restructuredtext",
                "markup.fenced_code.block.markdown punctuation.definition.markdown"
            ],
            "settings": {
                "foreground": "#20BB94"
            }
        },
        {
            "name": "Prose constants",
            "scope": [
                "punctuation.definition.constant.restructuredtext"
            ],
            "settings": {
                "foreground": "#B07AE6"
            }
        },
        {
            "name": "Braces in markdown headings",
            "scope": [
                "markup.heading.markdown punctuation.definition.string.begin",
                "markup.heading.markdown punctuation.definition.string.end"
            ],
            "settings": {
                "foreground": "#B07AE6"
            }
        },
        {
            "name": "Braces in markdown paragraphs",
            "scope": [
                "meta.paragraph.markdown punctuation.definition.string.begin",
                "meta.paragraph.markdown punctuation.definition.string.end"
            ],
            "settings": {
                "foreground": "#E6E7F2"
            }
        },
        {
            "name": "Braces in markdown blockquotes",
            "scope": [
                "markup.quote.markdown meta.paragraph.markdown punctuation.definition.string.begin",
                "markup.quote.markdown meta.paragraph.markdown punctuation.definition.string.end"
            ],
            "settings": {
                "foreground": "#ECE29C"
            }
        },
        {
            "name": "User-defined class names",
            "scope": [
                "entity.name.type.class",
                "entity.name.class"
            ],
            "settings": {
                "foreground": "#5F8DF0",
                "fontStyle": "bold",
            }
        },
        {
            "name": "this, super, self, etc.",
            "scope": [
                "keyword.expressions-and-types.swift",
                "keyword.other.this",
                "variable.language",
                "variable.language punctuation.definition.variable.php",
                "variable.other.readwrite.instance.ruby",
                "variable.parameter.function.language.special"
            ],
            "settings": {
                "foreground": "#B07AE6",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Inherited classes",
            "scope": [
                "entity.other.inherited-class"
            ],
            "settings": {
                "fontStyle": "italic bold",
                "foreground": "#5F8DF0"
            }
        },
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment",
                "unused.comment",
                "wildcard.comment"
            ],
            "settings": {
                "foreground": "#565CA1"
            }
        },
        {
            "name": "JSDoc-style keywords",
            "scope": [
                "comment keyword.codetag.notation",
                "comment.block.documentation keyword",
                "comment.block.documentation storage.type.class"
            ],
            "settings": {
                "foreground": "#CA5DAD"
            }
        },
        {
            "name": "JSDoc-style types",
            "scope": [
                "comment.block.documentation entity.name.type"
            ],
            "settings": {
                "foreground": "#5F8DF0",
                "fontStyle": "italic bold"
            }
        },
        {
            "name": "JSDoc-style type brackets",
            "scope": [
                "comment.block.documentation entity.name.type punctuation.definition.bracket"
            ],
            "settings": {
                "foreground": "#5F8DF0",
                "fontStyle": "bold"
            }
        },
        {
            "name": "JSDoc-style comment parameters",
            "scope": [
                "comment.block.documentation variable"
            ],
            "settings": {
                "foreground": "#E8A763",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Constants",
            "scope": [
                "constant",
                "variable.other.constant"
            ],
            "settings": {
                "foreground": "#B07AE6"
            }
        },
        {
            "name": "Constant escape sequences",
            "scope": [
                "constant.character.escape",
                "constant.character.string.escape",
                "constant.regexp"
            ],
            "settings": {
                "foreground": "#CA5DAD"
            }
        },
        {
            "name": "HTML tags",
        }
    ]
}